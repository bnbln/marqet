        "de" : { "stringUnit" : { "state" : "translated", "value" : "Marqet zeigt Filialen deiner Läden in der Nähe und sortiert deine Läden auf Wunsch nach Entfernung. Dein Standort bleibt auf deinem Gerät." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Marqet shows your stores' branches nearby and can sort your stores by distance. Your location stays on your device." } }
