    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Marqet scannt mit der Kamera den Barcode deiner Kundenkarten. Die Bilder verlassen dein Gerät nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet uses the camera to scan the barcode of your loyalty cards. The images never leave your device."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission prompt (stores nearby, sort by distance)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet zeigt Filialen deiner Läden in der Nähe und sortiert deine Läden auf Wunsch nach Entfernung. Dein Standort bleibt auf deinem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet shows your stores' branches nearby and can sort your stores by distance. Your location stays on your device."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet hört zu, wenn du deine Einkäufe einsprichst. Die Aufnahme wird auf deinem Gerät in Text umgewandelt und nicht gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet listens when you dictate your shopping. The recording is turned into text on your device and never stored."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Reminders permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet liest deine Einkaufsliste aus der Erinnerungen-App und speichert den Laden eines Eintrags in dessen Notizen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet reads your shopping list from the Reminders app and saves an item's store in its notes."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet wandelt deine eingesprochenen Einkäufe auf deinem Gerät in Einträge für deine Listen um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet turns your dictated shopping into entries for your lists, on your device."
          }
        }
      }
    }
  },
  "version" : "1.0"
