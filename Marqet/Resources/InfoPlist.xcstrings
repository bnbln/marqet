    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Marqet scannt mit der Kamera den Barcode deiner Kundenkarten. Die Bilder verlassen dein Gerät nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet uses the camera to scan the barcode of your loyalty cards. The images never leave your device."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Marqet meldet sich bei deinen Läden und zeigt deren Einkaufsliste. Für lokale Preisfunde sendet Marqet nur eine grob gerundete Position an Open Prices."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet alerts you at your stores and shows their shopping list. For local price finds, Marqet sends only a roughly rounded position to Open Prices."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission prompt (stores nearby, sort by distance)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet zeigt Filialen in deiner Nähe und sortiert Läden nach Entfernung. Für lokale Preisfunde sendet Marqet nur eine grob gerundete Position an Open Prices."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet shows branches near you and sorts stores by distance. For local price finds, Marqet sends only a roughly rounded position to Open Prices."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet hört zu, wenn du deine Einkäufe einsprichst. Die Aufnahme wird auf deinem Gerät in Text umgewandelt und nicht gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet listens when you dictate your shopping. The recording is turned into text on your device and never stored."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Reminders permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet liest deine Einkaufsliste aus der Erinnerungen-App und speichert den Laden eines Eintrags in dessen Notizen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet reads your shopping list from the Reminders app and saves an item's store in its notes."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet wandelt deine eingesprochenen Einkäufe auf deinem Gerät in Einträge für deine Listen um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet turns your dictated shopping into entries for your lists, on your device."
          }
        }
      }
    }
  },
  "version" : "1.0"
}