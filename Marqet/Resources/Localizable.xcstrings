      }
    },
    "Deine Einkaufsliste, nach Läden sortiert" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your shopping list, sorted by store"
          }
        }
      }
    },
    "Deine Einträge bleiben in Apple Erinnerungen. Kein Konto, keine Werbung." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your items stay in Apple Reminders. No account, no ads."
          }
        }
      }
    },
    "Deine Filiale" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Branch"
          }
        }
      }
    },
    "Deine Kundenkarte, ein Tipp bis zum Barcode an der Kasse." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your loyalty card, one tap away from the barcode at checkout."
          }
        }
      }
    },
    "Deine Läden" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Stores"
          }
        }
      }
    },
    "Deine Ladenkarten sind gerade nach %@ sortiert. Sobald du hier ziehst, gilt deine eigene Reihenfolge." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your store cards are currently sorted by %@. As soon as you drag here, your own order applies."
          }
        }
      }
    },
    "Deine Listen bleiben in Apple Erinnerungen. Läden und Kundenkarten speichert Marqet auf diesem Gerät." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your lists stay in Apple Reminders. Marqet keeps stores and loyalty cards on this device."
          }
        }
      }
    },
    "Deinen Standort nutzt Marqet nur mit deiner Erlaubnis. Für lokale Preissuchen sendet es eine auf etwa 10 km gerundete Position und einen Umkreis von 30 km an Open Prices. Ohne Standort nutzt es regionale Preise." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet uses your location only with permission. For nearby prices, it sends a position rounded to roughly 10 km and a 30 km search radius to Open Prices. Without location, it uses regional prices."
          }
        }
      }
    },
    "Deinen Standort nutzt Marqet nur, wenn du es erlaubst: für Filialen in der Nähe und die Sortierung nach Entfernung. Er wird weder gespeichert noch übertragen." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet uses your location only if you allow it: for branches nearby and sorting by distance. It is neither stored nor transmitted."
          }
        }
      }
    },
    "Den Laden eines Eintrags speichert Marqet als Zeile „🛒 Laden“ in den Notizen der Erinnerung. Mit wem du die Liste teilst, sieht diese Zeile auch." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet saves an item’s store as the line “🛒 Store” in the reminder’s notes. Anyone you share the list with sees this line too."
          }
        }
      }
    },
    "Den Laden merkt sich Marqet als Zeile „🛒 Laden“ in den Notizen, sichtbar auch in Erinnerungen und für alle, mit denen du die Liste teilst." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqet remembers the store as the line “🛒 Store” in the notes, visible in Reminders too and to everyone you share the list with."
          }
        }
      }
    },
    "Der Barcode für die Kasse und die Prospekte deiner Läden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The barcode for checkout and the leaflets from your stores."
          }
        }
      }
    },
    "Der Kauf wartet auf Freigabe, zum Beispiel durch „Kaufanfrage“." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The purchase is waiting for approval, for example through Ask to Buy."
          }
        }
      }
    },
    "Der Laden steht sichtbar in den Notizen des Eintrags – auch für alle, mit denen du die Liste teilst." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The store is visible in the item’s notes – also for anyone you share the list with."
          }
        }
      }
    },
    "Der nächste Laden steht vorn. Läden ohne Filiale folgen in deiner Reihenfolge." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The nearest store comes first. Stores without a branch follow in your order."
          }
        }
      }
    },
    "Deutschland" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Germany"
          }
        }
      }
    },
    "Die Adresse oder Info erscheint unter dem Ladennamen auf der Card." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address or info appears below the store name on the card."
          }
        }
      }
    },
    "Die aktuellen Prospekte deiner Läden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current leaflets from your stores."
          }
        }
      }
    },
    "Die bevorzugte Filiale bestimmt Entfernung, Kartenpunkt und die Adresse auf der Card." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The preferred branch sets the distance, the map pin and the address on the card."
          }
        }
      }
    },
    "Die erkannten Einträge werden nicht hinzugefügt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recognized items will not be added."
          }
        }
      }
    },
    "Die Karte erscheint im Vollbild dieser Läden. Eine Payback-Karte kannst du mehreren Läden zuordnen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The card appears in the full-screen view of these stores. You can assign a Payback card to several stores."
          }
        }
