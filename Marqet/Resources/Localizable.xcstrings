        }
      }
    },
    "Ziehe die Abschnitte in die Reihenfolge deines Wegs durch %@. Marqet lernt beim Abhaken weiter mit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag the sections into the order of your route through %@. Marqet keeps learning as you check items off."
