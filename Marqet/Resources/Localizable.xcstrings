      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The card appears in the full-screen view of these stores. You can assign a Payback card to several stores."
          }
        }
      }
    },
    "Die mitgelieferten Preise liegen in der App. Wenn du sie aktualisierst oder tägliche Updates einschaltest, fragt Marqet die passenden Produktkategorien bei Open Prices ab. Deine Eintragstexte und Läden werden dabei nicht gesendet." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The included prices are stored in the app. When you update them or enable daily updates, Marqet queries the relevant product categories from Open Prices. Your item names and stores are not sent."
          }
        }
      }
    },
