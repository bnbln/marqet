    },
    {
      "id": "02-voice",
      "args": ["-demo-voice"],
      "wait": 22,
      "title": { "de": "Sag einfach,\nwas du brauchst.", "en": "Just say\nwhat you need." },
      "subtitle": { "de": "Marqet sortiert schon beim Sprechen.", "en": "Marqet sorts it while you speak." }
    },
    {
      "id": "03-store",
      "args": ["-demo-page", "aldi-sued", "-demo-focus"],
      "wait": 6,
      "title": { "de": "Im Laden alles\nauf einen Blick.", "en": "Everything at a glance\nin store." },
      "subtitle": { "de": "Nach Kategorien geordnet, abhaken mit einem Tipp.", "en": "Grouped by aisle, checked off with a tap." }
    },
    {
      "id": "04-triage",
      "args": ["-demo-triage"],
      "wait": 6,
      "title": { "de": "Ein Tipp,\nund es ist sortiert.", "en": "One tap\nand it's sorted." },
      "subtitle": { "de": "Marqet merkt sich, wo du was kaufst.", "en": "Marqet remembers where you buy what." }
    },
    {
      "id": "05-map",
      "args": ["-demo-map", "-mapShowsOnlyStoresWithItems", "YES", "-mapShopCategory", "groceries"],
      "wait": 9,
      "title": { "de": "Deine Läden\nin der Nähe.", "en": "Your stores\nnearby." },
      "subtitle": { "de": "Filialen, Entfernung und Route.", "en": "Branches, distances and directions." }
    },
    {
      "id": "06-widgets",
      "args": ["-widget-showcase"],
      "wait": 6,
      "title": { "de": "Deine Liste\nauf dem Home-Bildschirm.", "en": "Your list\non your Home Screen." },
      "subtitle": { "de": "Abhaken, ohne die App zu öffnen.", "en": "Check things off without opening the app." }
    }
